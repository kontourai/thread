{
  "name": "@kontourai/ferry",
  "version": "0.1.0",
  "description": "Migrate AI conversations between tools — importers and exporters for @kontourai/thread",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "ferry": "dist/src/cli.js"
  },
  "files": [
    "dist/src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && chmod +x dist/src/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run"
  },
  "keywords": [
    "ai",
    "conversation",
    "migration",
    "import",
    "export",
    "claude-code",
    "codex",
    "opencode",
    "chatgpt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kontourai/thread.git",
    "directory": "packages/ferry"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@kontourai/thread": "^0.1.0",
    "commander": "^14.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
