{
  "name": "@kontourai/thread",
  "version": "0.3.0",
  "description": "Canonical AI conversation schema — a portable message format for agent threads",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "npm run build && vitest run"
  },
  "keywords": [
    "ai",
    "conversation",
    "thread",
    "schema",
    "llm",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kontourai/thread.git",
    "directory": "packages/thread"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
